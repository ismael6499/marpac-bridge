<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MarpacBridge" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary_neon</item>
        <item name="colorPrimaryVariant">@color/primary_neon</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/accent_neon</item>
        <item name="colorSecondaryVariant">@color/accent_neon</item>
        <item name="colorOnSecondary">@color/bg_dark</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>
</resources>
